platform :ios, '16.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'
project 'Runner', { 'Debug' => :debug, 'Profile' => :release, 'Release' => :release }

settings = File.expand_path('Flutter/Generated.xcconfig', __dir__)
abort 'Run flutter pub get before pod install' unless File.exist?(settings)
flutter_root = File.foreach(settings).filter_map { |line| line[/^FLUTTER_ROOT=(.+)/, 1]&.strip }.first
abort 'FLUTTER_ROOT is missing from Generated.xcconfig' unless flutter_root

require File.join(flutter_root, 'packages/flutter_tools/bin/podhelper')
flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static
  flutter_install_all_ios_pods(File.dirname(File.realpath(__FILE__)))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
